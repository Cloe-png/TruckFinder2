<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.truckfinder2.views.LoginViewController">
    <VBox alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
        <Label fx:id="messageLabel" style="-fx-text-fill: red;" />
    </VBox>
     <TextField fx:id="emailField" layoutX="162.0" layoutY="142.0" prefHeight="25.0" prefWidth="251.0" promptText="Email" />
     <PasswordField fx:id="passwordField" layoutX="162.0" layoutY="188.0" prefHeight="25.0" prefWidth="251.0" promptText="Mot de passe" />
     <Label layoutX="240.0" layoutY="98.0" style="-fx-font-size: 20px;" text="Connexion" />
     <Button layoutX="259.0" layoutY="255.0" onAction="#handleLogin" text="Se connecter" />
     <Button layoutX="269.0" layoutY="311.0" onAction="#handleRegister" text="S'inscrire" />
</AnchorPane>
